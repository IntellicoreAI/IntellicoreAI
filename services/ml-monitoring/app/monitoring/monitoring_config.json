
{
    "config_version": "1.0",
    "model": {
        "model_name": "xgboost_credit_risk",
        "model_version": "1.0"
    },
    "data_quality": {
        "max_missing_rate": 0.0,
        "max_event_age": "15min",
        "duplicate_event_id_policy": "warning"
    },
    "data_drift": {
        "method": "ks_2samp",
        "significance_level": 0.05,
        "multiple_testing_correction": "bonferroni"
    },
    "prediction_drift": {
        "method": "ks_2samp",
        "significance_level": 0.05
    },
    "performance": {
        "relative_degradation_threshold": 0.20
    }
}
