{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntelliCore OS Base Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "project_id",
    "environment",
    "model",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "prediction",
        "monitoring_result",
        "alert"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_name",
        "model_version"
      ],
      "properties": {
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "data": {
      "type": "object"
    }
  }
}
